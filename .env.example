SERVER_PORT=5050
SERVER_HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:5050

DB_HOST=localhost
# Used by backend/docker-compose.yml for the API container (hostname of the Postgres service).
DOCKER_DB_HOST=db
# Host port published for Postgres (TablePlus / psql on the Mac). If `psql ...@127.0.0.1:5432` shows empty tables but the API has data,
# another Postgres is bound on localhost:5432 — set 5433 (or free port) and point TablePlus at that port.
DOCKER_DB_PUBLISH=5433
DB_PORT=5432
# Must match the "Database" field in TablePlus (not only the connection name). GET /api/health shows postgresDatabase.
DB_NAME=ive_ar_gallery
DB_USER=postgres
DB_PASS=postgres
DB_POOL_MIN=1
DB_POOL_MAX=5

VUFORIA_ACCESS_KEY=
VUFORIA_SECRET_KEY=
VUFORIA_HOST=https://vws.vuforia.com
VUFORIA_TARGET_WIDTH=1.0

# Also supported for files exported/shared with these names:
VUFORIA_BASE_URL=https://vws.vuforia.com
VUFORIA_SERVER_ACCESS_KEY=
VUFORIA_SERVER_SECRET_KEY=
