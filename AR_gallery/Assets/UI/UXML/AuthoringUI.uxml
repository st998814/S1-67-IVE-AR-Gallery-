<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../USS/AuthoringUI.uss" />
    <ui:VisualElement name="AuthoringRoot" class="authoring-root" picking-mode="Ignore" style="flex-direction: column;">
        <ui:VisualElement name="TopBar" class="top-bar" picking-mode="Position">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label text="Workspace:" class="text-secondary" style="font-size: 11px; margin-right: 6px;"/>
                <ui:Label name="WorkspaceNameLabel" text="Authoring" class="text-primary" style="-unity-font-style: bold; font-size: 12px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; column-gap: 8px;">
                <ui:Label name="ModeIndicatorLabel" text="Mode: Move" class="text-secondary" style="font-size: 11px;"/>
                <ui:Button name="BackToSwitcherButton" text="Return" class="button" style="height: 28px; min-width: 88px; -unity-font-style: bold; font-size: 11px;"/>
                <ui:Button name="SaveButton" text="Save to Database" class="button" style="height: 28px; min-width: 132px; -unity-font-style: bold; font-size: 11px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="WorkspaceLayout" class="workspace-layout" picking-mode="Ignore">
            <ui:VisualElement name="LeftPanelContainer" picking-mode="Ignore" style="height: 100%; flex-direction: row;">
                <ui:VisualElement name="LeftPanelBody" class="panel panel--collapsed" picking-mode="Position" style="width: 300px; min-width: 300px; border-right-width: 1px;">
                    <ui:Label text="Content Library" class="text-primary" style="-unity-font-style: bold; font-size: 12px; margin-bottom: 6px;"/>
                    <ui:Label text="Runtime uploads appear here" class="text-secondary" style="font-size: 10px; margin-bottom: 8px;"/>
                    <ui:Button name="AddContentButton" text="Add Content" class="button" style="height: 26px; width: 100%; -unity-font-style: bold; font-size: 11px; margin-bottom: 8px;"/>
                    <ui:ListView name="ContentLibraryList" style="height: 180px; background-color: rgba(17, 24, 39, 0.9); border-width: 1px; border-color: rgb(31, 41, 51); border-radius: 4px;"/>
                </ui:VisualElement>
                <ui:Button name="LeftPanelToggle" text="&gt;" class="panel-toggle" picking-mode="Position" style="border-top-right-radius: 4px; border-bottom-right-radius: 4px;"/>
            </ui:VisualElement>

            <ui:VisualElement name="CenterViewport" picking-mode="Ignore" style="flex-grow: 1;"/>

            <ui:VisualElement name="RightPanelContainer" picking-mode="Ignore" style="height: 100%; flex-direction: row;">
                <ui:Button name="RightPanelToggle" text="&lt;" class="panel-toggle" picking-mode="Position" style="border-top-left-radius: 4px; border-bottom-left-radius: 4px;"/>
                <ui:VisualElement name="RightPanelBody" class="panel panel--collapsed" picking-mode="Position" style="width: 320px; min-width: 320px; border-left-width: 1px;">
                    <ui:Label text="Inspector" class="text-primary" style="-unity-font-style: bold; font-size: 12px; margin-bottom: 8px;"/>
                    <ui:VisualElement style="flex-direction: row; column-gap: 6px; margin-bottom: 8px;">
                        <ui:Button name="InspectorTargetTabButton" text="Target" class="button button--active" style="flex-grow: 1; height: 24px; font-size: 10px;"/>
                        <ui:Button name="InspectorContentTabButton" text="Content" class="button" style="flex-grow: 1; height: 24px; font-size: 10px;"/>
                    </ui:VisualElement>
                    <ui:Label text="Spatial Coordinates:" class="text-secondary" style="-unity-font-style: bold; margin-top: 4px; margin-bottom: 2px; font-size: 11px;"/>
                    <ui:FloatField name="PosXInput" label="X Position" value="0" class="input-field" style="margin-bottom: 2px; min-height: 24px; font-size: 11px; -unity-property-field-label-width: 100px;"/>
                    <ui:FloatField name="PosYInput" label="Y Position" value="0" class="input-field" style="margin-bottom: 2px; min-height: 24px; font-size: 11px; -unity-property-field-label-width: 100px;"/>
                    <ui:FloatField name="PosZInput" label="Z Position" value="0" class="input-field" style="margin-bottom: 2px; min-height: 24px; font-size: 11px; -unity-property-field-label-width: 100px;"/>
                    <ui:VisualElement name="TargetReferenceContainer" style="display: none; flex-direction: column; margin-top: 10px;">
                        <ui:Label text="Target Reference (optional):" class="text-secondary" style="-unity-font-style: bold; margin-top: 0px; margin-bottom: 6px; font-size: 11px;"/>
                        <ui:Button name="BrowseTargetReferenceButton" text="Upload Reference" class="button" style="height: 26px; width: 100%; -unity-font-style: bold; font-size: 11px; margin-bottom: 6px;"/>
                        <ui:Image name="TargetReferencePreviewImage" scale-mode="ScaleToFit" style="display: none; height: 140px; margin-bottom: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-color: rgb(31, 41, 51); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; background-color: rgba(17, 24, 39, 0.9);"/>
                        <ui:Label name="TargetReferenceStatusLabel" text="Not uploaded yet" class="text-disabled" style="font-size: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="loading-overlay" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.59); justify-content: center; align-self: center;">
        <ui:Label text="Loading..." style="align-self: center; align-items: auto; justify-content: flex-end; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-style: bold; color: rgb(255, 250, 240); align-content: flex-end;"/>
    </ui:VisualElement>
    <ui:VisualElement name="error-toast" style="flex-grow: 1; position: absolute; top: 50px; align-self: center; background-color: rgb(220, 53, 69); border-top-left-radius: 8px; border-top-right-radius: 8px; border-right-width: 0; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; width: 300px; height: 100px;">
        <ui:Label name="error-label" text="Error" parse-escape-sequences="true" style="padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; align-self: center; -unity-font-style: bold; -unity-text-outline-color: rgb(229, 229, 229); color: rgb(229, 229, 229); display: flex;"/>
    </ui:VisualElement>
</ui:UXML>
