.switcher-root {
    justify-content: center;
    align-items: center;
}

.switcher-title {
    margin-bottom: 20px;
}

.switcher-carousel {
    width: 100%;
    max-width: 980px;
    height: 190px;
    justify-content: center;
    margin-bottom: 16px;
}

.switcher-arrow-btn {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
}

.switcher-arrow-left {
    margin-right: 12px;
}

.switcher-arrow-right {
    margin-left: 12px;
}

.switcher-cards-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.switcher-selection-label {
    margin-bottom: 18px;
}

.switcher-actions {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.switcher-action-secondary {
    min-width: 160px;
    height: 46px;
}

.switcher-action-primary {
    min-width: 160px;
    height: 46px;
    margin-left: 14px;
}

.switcher-action-danger {
    min-width: 160px;
    height: 46px;
    margin-left: 14px;
    background-color: rgb(185, 28, 28);
    border-left-color: rgb(248, 113, 113);
    border-right-color: rgb(248, 113, 113);
    border-top-color: rgb(248, 113, 113);
    border-bottom-color: rgb(248, 113, 113);
    color: rgb(255, 255, 255);
}

.switcher-action-danger:hover {
    background-color: rgb(220, 38, 38);
}

.switcher-action-danger:active {
    background-color: rgb(153, 27, 27);
}

.workspace-add-card {
    width: 240px;
    height: 150px;
    justify-content: center;
    align-items: center;
    background-color: var(--color-surface-secondary);
    border-width: 1px;
    border-color: #8CBFFF;
    border-radius: 12px;
    cursor: pointer;
}

.workspace-add-card:hover {
    background-color: rgba(26, 36, 52, 0.98);
}

.workspace-add-card__icon {
    width: 100%;
    text-align: center;
    color: rgb(255, 255, 255);
}

.workspace-add-card__label {
    width: 100%;
    text-align: center;
    color: rgb(255, 255, 255);
    font-size: 18px;
    font-weight: bold;
}
