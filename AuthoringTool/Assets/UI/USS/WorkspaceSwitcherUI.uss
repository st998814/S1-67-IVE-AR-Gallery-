.switcher-root {
    justify-content: center;
    align-items: center;
    position: relative;
}

.switcher-back-btn {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    margin: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: rgb(27, 34, 43);
    justify-content: center;
    align-items: center;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 0;
}

.switcher-back-btn:hover {
    background-color: rgb(38, 48, 60);
}

.switcher-back-btn:active {
    background-color: rgb(22, 28, 36);
}

.switcher-back-btn__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    background-image: url("../Icons/SwitcherBackArrow.svg");
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: center;
}

.switcher-title {
    margin-bottom: 20px;
}

.switcher-carousel {
    width: 100%;
    max-width: 980px;
    height: 190px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

/* Keeps arrows tight to the card strip (avoids flex-grow pushing the right arrow outward). */
.switcher-carousel-track {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-grow: 0;
}

.switcher-carousel-viewport {
    flex-shrink: 0;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    height: 170px;
}

.switcher-carousel-arrow {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: rgb(27, 34, 43);
    justify-content: center;
    align-items: center;
    font-size: 0;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
}

.switcher-carousel-arrow:hover {
    background-color: rgb(38, 48, 60);
}

.switcher-carousel-arrow:active {
    background-color: rgb(22, 28, 36);
}

.switcher-carousel-arrow:disabled {
    opacity: 0.35;
    background-color: rgb(27, 34, 43);
}

.switcher-carousel-arrow--left {
    margin-right: 8px;
    margin-left: 0;
}

.switcher-carousel-arrow--right {
    margin-left: 8px;
    margin-right: 0;
}

.switcher-carousel-arrow__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: center;
}

.switcher-carousel-arrow__icon--left {
    background-image: url("../Icons/SwitcherBackArrow.svg");
}

.switcher-carousel-arrow__icon--right {
    background-image: url("../Icons/SwitcherCarouselArrowRight.svg");
}

.switcher-cards-row {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-left: 0;
    margin-right: 0;
}

.switcher-selection-label {
    margin-bottom: 18px;
}

.switcher-delete-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    justify-content: center;
    align-items: center;
}

.switcher-delete-overlay--hidden {
    display: none;
}

.switcher-delete-overlay--visible {
    display: flex;
}

.switcher-delete-dialog {
    width: 100%;
    max-width: 420px;
    margin-left: 24px;
    margin-right: 24px;
    padding: 24px;
    border-radius: 12px;
    background-color: rgb(20, 26, 33);
    border-width: 1px;
    border-color: rgb(36, 48, 59);
}

.switcher-delete-dialog__title {
    color: rgb(230, 237, 243);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.switcher-delete-dialog__message {
    color: rgb(154, 167, 179);
    font-size: 14px;
    margin-bottom: 20px;
    white-space: normal;
}

.switcher-delete-dialog__actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.switcher-delete-dialog__btn {
    min-width: 100px;
    height: 40px;
    margin-left: 0;
}

.switcher-delete-dialog__btn--cancel {
    margin-right: 10px;
    background-color: rgb(38, 48, 60);
    border-width: 0;
}

.switcher-delete-dialog__btn--confirm {
    background-color: rgb(185, 28, 28);
    border-width: 0;
    color: rgb(255, 255, 255);
}

.switcher-delete-dialog__btn--confirm:hover {
    background-color: rgb(220, 38, 38);
}

.workspace-card__toolbar {
    position: absolute;
    right: 8px;
    bottom: 8px;
    flex-direction: row;
    align-items: center;
    opacity: 0;
    visibility: hidden;
}

.workspace-card__toolbar--visible {
    opacity: 1;
    visibility: visible;
}

.workspace-card__icon-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    margin-left: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: rgb(27, 34, 43);
    justify-content: center;
    align-items: center;
    font-size: 0;
}

.workspace-card__icon-btn:hover {
    background-color: rgb(38, 48, 60);
}

.workspace-card__icon-btn--delete:hover {
    background-color: rgb(120, 32, 40);
}

.workspace-card__icon-btn__glyph {
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: center;
}

.workspace-card__icon-btn--open .workspace-card__icon-btn__glyph {
    background-image: url("../Icons/SwitcherOpenPencil.svg");
}

.workspace-card__icon-btn--delete .workspace-card__icon-btn__glyph {
    background-image: url("../Icons/SwitcherDeleteTrash.svg");
}

.workspace-card {
    position: relative;
    overflow: hidden;
}

.workspace-card__thumbnail {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.workspace-card__thumbnail--placeholder {
    justify-content: center;
    align-items: center;
    display: flex;
    background-color: rgba(20, 26, 33, 1);
}

.workspace-card__thumbnail-placeholder-label {
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
    font-weight: bold;
    text-align: center;
}

.workspace-card__scrim {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.24);
}

.workspace-card__label {
    position: absolute;
    left: 12px;
    right: 92px;
    bottom: 12px;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.64);
    color: rgb(255, 255, 255);
    font-size: 14px;
    font-weight: bold;
    unity-font-style: bold;
    unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.workspace-add-card {
    width: 240px;
    height: 150px;
    justify-content: center;
    align-items: center;
    background-color: var(--color-surface-secondary);
    border-width: 1px;
    border-color: #8CBFFF;
    border-radius: 12px;
    cursor: pointer;
}

.workspace-add-card:hover {
    background-color: rgba(26, 36, 52, 0.98);
}

.workspace-add-card__icon {
    width: 100%;
    text-align: center;
    color: rgb(255, 255, 255);
}

.workspace-add-card__label {
    width: 100%;
    text-align: center;
    color: rgb(255, 255, 255);
    font-size: 18px;
    font-weight: bold;
}
