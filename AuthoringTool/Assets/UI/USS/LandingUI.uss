.landing-root {
    justify-content: center;
    align-items: center;
}

.landing-stack {
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 640px;
    padding-left: 24px;
    padding-right: 24px;
}

.landing-title {
    margin-bottom: 12px;
    letter-spacing: 0.2px;
}

.landing-subtitle {
    margin-bottom: 24px;
    text-align: center;
}

.landing-start-btn {
    min-width: 180px;
    height: 48px;
}
