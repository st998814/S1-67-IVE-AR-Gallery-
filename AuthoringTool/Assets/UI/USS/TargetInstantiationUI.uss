.target-setup-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(7, 11, 24);
    position: relative;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.target-setup-bg-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-top-left-radius: 210px;
    border-top-right-radius: 210px;
    border-bottom-left-radius: 210px;
    border-bottom-right-radius: 210px;
    opacity: 0.22;
}

.target-setup-bg-glow-left {
    left: -120px;
    top: -80px;
    background-color: rgb(56, 117, 255);
}

.target-setup-bg-glow-right {
    right: -120px;
    bottom: -120px;
    background-color: rgb(82, 224, 194);
}

.target-setup-card {
    width: 100%;
    max-width: 860px;
    min-width: 320px;
    background-color: rgba(18, 24, 48, 0.88);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(133, 165, 255, 0.35);
    border-right-color: rgba(133, 165, 255, 0.35);
    border-bottom-color: rgba(133, 165, 255, 0.35);
    border-left-color: rgba(133, 165, 255, 0.35);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.target-setup-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(242, 247, 255);
    margin-bottom: 6px;
    -unity-text-align: middle-left;
}

.target-setup-subtitle {
    font-size: 14px;
    color: rgba(196, 212, 255, 0.95);
    margin-bottom: 16px;
}

.target-setup-section {
    margin-top: 8px;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(24, 32, 64, 0.7);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(121, 163, 255, 0.18);
    border-right-color: rgba(121, 163, 255, 0.18);
    border-bottom-color: rgba(121, 163, 255, 0.18);
    border-left-color: rgba(121, 163, 255, 0.18);
}

.target-setup-section-title {
    color: rgb(155, 196, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.target-setup-section TextField,
.target-setup-section FloatField {
    margin-bottom: 10px;
    color: rgb(236, 243, 255);
    -unity-property-field-label-width: 170px;
}

.target-setup-section TextField > Label,
.target-setup-section FloatField > Label {
    color: rgba(197, 212, 246, 0.94);
    font-size: 14px;
}

.target-setup-section TextField > VisualElement,
.target-setup-section FloatField > VisualElement,
.target-setup-section DropdownField > VisualElement {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(133, 160, 230, 0.36);
    border-right-color: rgba(133, 160, 230, 0.36);
    border-bottom-color: rgba(133, 160, 230, 0.36);
    border-left-color: rgba(133, 160, 230, 0.36);
    min-height: 40px;
}

.target-setup-section TextField .unity-text-field__input,
.target-setup-section TextField .unity-base-text-field__input,
.target-setup-section FloatField .unity-text-field__input,
.target-setup-section FloatField .unity-base-text-field__input,
.target-setup-section DropdownField .unity-text-field__input,
.target-setup-section DropdownField .unity-base-text-field__input {
    color: rgb(0, 0, 0);
    font-size: 16px;
}

.target-setup-status {
    margin-top: 6px;
    margin-bottom: 12px;
    min-height: 36px;
    color: rgb(167, 236, 216);
    font-size: 12px;
    white-space: normal;
}

.target-setup-actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.target-setup-btn {
    height: 34px;
    min-width: 128px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-font-style: bold;
    font-size: 11px;
}

.target-setup-btn-secondary,
.target-setup-btn-ghost {
    margin-left: 8px;
}

.target-setup-btn-primary {
    background-color: rgb(56, 126, 255);
    color: rgb(245, 250, 255);
}

.target-setup-btn-secondary {
    background-color: rgb(48, 86, 166);
    color: rgb(232, 243, 255);
}

.target-setup-btn-ghost {
    background-color: rgba(52, 60, 84, 0.95);
    color: rgb(223, 232, 248);
}
