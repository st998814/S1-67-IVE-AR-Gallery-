.target-setup-root {
    flex-grow: 1;
    position: relative;
    flex-direction: column;
    align-items: stretch;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 16px;
}

.target-setup-back-btn {
    position: absolute;
    left: 24px;
    top: 24px;
}

.target-setup-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 52px;
    margin-bottom: 6px;
    align-self: center;
    width: 100%;
    max-width: 820px;
    justify-content: center;
    align-items: stretch;
}

.target-setup-wizard {
    flex-grow: 1;
    justify-content: center;
    align-items: stretch;
}

.target-setup-nav-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
}

.target-setup-nav-arrow {
    flex-shrink: 0;
}

.target-setup-nav-arrow--prev {
    margin-right: 10px;
}

.target-setup-nav-arrow--next {
    margin-left: 10px;
}

.target-setup-nav-arrow--hidden {
    visibility: hidden;
    opacity: 0;
}

.target-setup-step-slot {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    max-width: 680px;
    min-width: 300px;
}

.target-setup-step-card {
    width: 100%;
    padding: 22px 26px 20px 26px;
    border-radius: 12px;
    background-color: rgba(20, 26, 33, 0.92);
    border-width: 1px;
    border-color: rgb(36, 48, 59);
}

.target-setup-step-card--hidden {
    display: none;
}

.target-setup-step-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(230, 237, 243);
    margin-bottom: 6px;
}

.target-setup-step-subtitle {
    font-size: 14px;
    color: rgb(154, 167, 179);
    margin-bottom: 14px;
    white-space: normal;
}

.target-setup-summary {
    font-size: 12px;
    color: rgb(167, 196, 255);
    margin-top: 4px;
    margin-bottom: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    background-color: rgba(27, 34, 43, 0.9);
    border-width: 1px;
    border-color: rgba(140, 191, 255, 0.25);
    white-space: normal;
}

.target-setup-step-dots {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    align-self: center;
    margin-bottom: 12px;
}

.target-setup-step-dot {
    width: 9px;
    height: 9px;
    min-width: 9px;
    min-height: 9px;
    margin-left: 5px;
    margin-right: 5px;
    border-radius: 50%;
    background-color: rgba(154, 167, 179, 0.45);
    border-width: 1px;
    border-color: rgba(140, 191, 255, 0.35);
}

.target-setup-step-dot--active {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    background-color: rgb(140, 191, 255);
    border-color: rgb(196, 220, 255);
}

.target-setup-hint {
    font-size: 12px;
    color: rgb(154, 167, 179);
    margin-bottom: 10px;
    white-space: normal;
}

.target-setup-hint--tight {
    margin-top: -4px;
    margin-bottom: 8px;
}

.target-setup-image-picker {
    position: relative;
    width: 100%;
    height: 240px;
    min-height: 240px;
    margin-bottom: 14px;
    padding: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(52, 66, 82);
    background-color: rgba(0, 0, 0, 0.35);
    overflow: hidden;
    align-items: stretch;
    justify-content: center;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 0;
}

.target-setup-image-picker--empty {
    border-color: rgb(68, 84, 102);
}

.target-setup-image-picker:hover {
    border-color: rgb(140, 191, 255);
}

.target-setup-image-picker:disabled {
    opacity: 0.55;
}

.target-setup-image-picker__media {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
    -unity-background-scale-mode: scale-and-crop;
}

.target-setup-image-picker--empty .target-setup-image-picker__media {
    background-color: rgba(12, 16, 22, 0.75);
}

.target-setup-image-picker__overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 12, 18, 0.72);
}

.target-setup-image-picker--empty:hover .target-setup-image-picker__overlay--upload {
    display: flex;
}

.target-setup-image-picker--has-image:hover .target-setup-image-picker__overlay--change {
    display: flex;
}

.target-setup-image-picker__icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.target-setup-image-picker__icon--plus {
    background-image: url("../Icons/TargetImageUploadPlus.svg");
}

.target-setup-image-picker__icon--cycle {
    background-image: url("../Icons/TargetImageChangeCycle.svg");
}

.target-setup-image-picker__overlay-label {
    font-size: 15px;
    color: rgb(230, 237, 243);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.target-setup-field {
    margin-bottom: 10px;
    flex-direction: column;
    -unity-property-field-label-width: 0;
}

.target-setup-field--compact {
    margin-bottom: 6px;
}

.target-setup-field > VisualElement,
.target-setup-field > .unity-base-field__input,
.target-setup-field.unity-base-field__aligned {
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(36, 48, 59);
    min-height: 38px;
}

.target-setup-field--active > VisualElement,
.target-setup-field--active > .unity-base-field__input,
.target-setup-field--active.unity-base-field__aligned {
    border-color: rgb(77, 163, 255);
    border-width: 2px;
    background-color: rgb(246, 250, 255);
}

.target-setup-field .unity-text-field__input,
.target-setup-field .unity-base-text-field__input,
.target-setup-field .unity-base-popup-field__input,
.target-setup-field .unity-float-field__input {
    color: rgb(0, 0, 0);
    font-size: 15px;
}

.target-setup-field > Label,
.target-setup-field .unity-base-field__label,
.target-setup-field .unity-dropdown-field__label,
.target-setup-field .unity-text-field__label,
.target-setup-field .unity-float-field__label {
    color: rgb(196, 212, 255);
    font-size: 13px;
    margin-bottom: 4px;
    min-width: 0;
}

.target-setup-field--conditional {
    display: none;
}

.target-setup-field--conditional--visible {
    display: flex;
}

.target-setup-toggle {
    margin-bottom: 10px;
    color: rgb(230, 237, 243);
}

.target-setup-advanced-toggle {
    align-self: flex-start;
    height: 32px;
    min-width: 0;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 8px;
    background-color: transparent;
    border-width: 0;
    color: rgb(140, 191, 255);
    font-size: 13px;
    -unity-font-style: bold;
}

.target-setup-advanced-toggle:hover {
    color: rgb(196, 220, 255);
}

.target-setup-advanced {
    display: none;
    margin-bottom: 12px;
    padding: 12px;
    border-radius: 10px;
    background-color: rgba(15, 20, 26, 0.65);
    border-width: 1px;
    border-color: rgba(36, 48, 59, 0.9);
}

.target-setup-advanced--expanded {
    display: flex;
}

.target-setup-submit-btn {
    width: 100%;
    height: 46px;
    margin-top: 6px;
    -unity-font-style: bold;
    font-size: 14px;
}

.target-setup-status {
    flex-shrink: 0;
    align-self: center;
    width: 100%;
    max-width: 680px;
    min-height: 40px;
    padding: 10px 14px;
    border-radius: 8px;
    border-width: 1px;
}

.target-setup-status__text {
    font-size: 13px;
    white-space: normal;
    color: rgb(230, 237, 243);
}

.target-setup-status--idle {
    background-color: rgba(27, 34, 43, 0.85);
    border-color: rgb(36, 48, 59);
}

.target-setup-status--idle .target-setup-status__text {
    color: rgb(154, 167, 179);
}

.target-setup-status--info {
    background-color: rgba(37, 99, 235, 0.2);
    border-color: rgb(77, 163, 255);
}

.target-setup-status--busy {
    background-color: rgba(37, 99, 235, 0.15);
    border-color: rgb(77, 163, 255);
}

.target-setup-status--error {
    background-color: rgba(127, 29, 29, 0.35);
    border-color: rgb(248, 113, 113);
}

.target-setup-status--error .target-setup-status__text {
    color: rgb(254, 226, 226);
}

.target-setup-status--success {
    background-color: rgba(20, 83, 45, 0.35);
    border-color: rgb(74, 222, 128);
}

.target-setup-status--success .target-setup-status__text {
    color: rgb(220, 252, 231);
}

.target-setup-keyboard-toggle {
    margin-top: 8px;
    align-self: flex-end;
    min-width: 140px;
    height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(27, 34, 43, 0.92);
    border-width: 1px;
    border-color: rgb(52, 66, 82);
    border-radius: 7px;
    color: rgb(196, 220, 255);
    -unity-font-style: bold;
}

.target-setup-keyboard-toggle:hover {
    border-color: rgb(77, 163, 255);
    color: rgb(230, 237, 243);
}

.target-setup-keyboard {
    margin-top: 8px;
    width: 100%;
    max-width: 680px;
    align-self: center;
    padding: 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(52, 66, 82);
    background-color: rgba(15, 20, 26, 0.92);
}

.target-setup-keyboard--hidden {
    display: none;
}

.target-setup-keyboard__target {
    font-size: 12px;
    color: rgb(167, 196, 255);
    margin-bottom: 8px;
}

.target-setup-keyboard__keys {
    flex-direction: column;
}

.target-setup-keyboard__row {
    flex-direction: row;
    margin-bottom: 6px;
}

.target-setup-keyboard__key {
    min-width: 32px;
    height: 30px;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(27, 34, 43);
    border-width: 1px;
    border-color: rgb(52, 66, 82);
    border-radius: 6px;
    color: rgb(230, 237, 243);
    -unity-font-style: bold;
}

.target-setup-keyboard__key:hover {
    border-color: rgb(77, 163, 255);
}

.target-setup-keyboard__key--wide {
    min-width: 66px;
}

.target-setup-keyboard__key--extra-wide {
    min-width: 104px;
}
