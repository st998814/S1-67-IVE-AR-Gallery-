<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../USS/AppTheme.uss" />
    <ui:Style src="../USS/TargetInstantiationUI.uss" />
    <ui:VisualElement name="TargetSetupRoot" class="target-setup-root" style="flex-grow: 1; justify-content: center; align-items: center; background-color: rgb(8, 12, 26); padding-left: 28px; padding-right: 28px; padding-top: 24px; padding-bottom: 24px;">
        <ui:VisualElement name="TargetSetupCard" class="target-setup-card" style="width: 100%; max-width: 860px; background-color: rgba(18, 24, 48, 0.92); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(133, 165, 255, 0.4); border-right-color: rgba(133, 165, 255, 0.4); border-bottom-color: rgba(133, 165, 255, 0.4); border-left-color: rgba(133, 165, 255, 0.4); padding-left: 28px; padding-right: 28px; padding-top: 24px; padding-bottom: 24px;">
            <ui:Label text="Create the new workspace" style="font-size: 26px; -unity-font-style: bold; color: rgb(242, 247, 255); margin-bottom: 6px;" />
            <ui:Label text="Create target before entering authoring workspace." style="font-size: 13px; color: rgba(196, 212, 255, 0.95); margin-bottom: 18px;" />

            <ui:Label text="Required" style="color: rgb(242, 61, 21); font-size: 12px; -unity-font-style: bold; margin-bottom: 10px;" />
            <ui:VisualElement class="target-setup-section">
                <ui:TextField name="WorkspaceNameInput" label="Workspace Name" style="margin-bottom: 10px; -unity-property-field-label-width: 180px;" />
                <ui:TextField name="TargetNameInput" label="Target Name" style="margin-bottom: 10px; -unity-property-field-label-width: 180px;" />
                <ui:TextField name="DisplayLabelInput" label="Display Label" style="margin-bottom: 10px; -unity-property-field-label-width: 180px;" />
                <ui:DropdownField name="TargetPostureDropdown" label="Target Posture" style="margin-bottom: 10px; -unity-property-field-label-width: 180px;" />
                <ui:Button name="BrowseTargetImageButton" text="Choose Target Image..." style="height: 40px; min-width: 220px; margin-bottom: 10px; background-color: rgb(43, 70, 130); color: rgb(235, 244, 255); font-size: 13px;" />
                <ui:Label name="SelectedTargetImageLabel" text="No target image selected." style="margin-bottom: 12px; color: rgba(196, 212, 255, 0.95); font-size: 12px;" />
                <ui:FloatField name="PhysicalWidthInput" label="Physical Width (m)" value="0.2" style="margin-bottom: 14px; -unity-property-field-label-width: 180px;" />
            </ui:VisualElement>

            <ui:Label text="Optional" style="color: rgb(9, 240, 94); font-size: 12px; -unity-font-style: bold; margin-bottom: 10px;" />
            <ui:VisualElement class="target-setup-section">
                <ui:TextField name="TargetIdInput" label="Target ID" style="margin-bottom: 10px; -unity-property-field-label-width: 180px;" />
                <ui:TextField name="VuforiaTargetNameInput" label="Vuforia Target Name" style="margin-bottom: 14px; -unity-property-field-label-width: 180px;" />
            </ui:VisualElement>

            <ui:Label name="StatusLabel" text="Create target to continue." style="margin-top: 6px; margin-bottom: 16px; min-height: 40px; color: rgb(167, 236, 216); font-size: 13px; white-space: normal;" />

            <ui:VisualElement style="flex-direction: row; justify-content: flex-end; align-items: center;">
                <ui:Button name="SubmitTargetButton" text="Create" style="height: 42px; min-width: 190px; -unity-font-style: bold; font-size: 13px; background-color: rgb(56, 126, 255); color: rgb(245, 250, 255);" />
                <ui:Button name="CancelButton" text="Cancel" style="height: 42px; min-width: 120px; margin-left: 12px; -unity-font-style: bold; font-size: 13px; background-color: rgba(52, 60, 84, 0.95); color: rgb(223, 232, 248);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
