<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../USS/AppTheme.uss" />
    <ui:Style src="../USS/AppFlowBackground.uss" />
    <ui:Style src="../USS/WorkspaceSwitcherUI.uss" />
    <ui:Style src="../USS/TargetInstantiationUI.uss" />

    <ui:VisualElement name="TargetSetupRoot" class="target-setup-root app-flow-wallpaper">
        <ui:Button name="BackToSwitcherButton" tooltip="Back to workspaces" class="switcher-back-btn target-setup-back-btn">
            <ui:VisualElement class="switcher-back-btn__icon" />
        </ui:Button>

        <ui:VisualElement name="TargetSetupBody" class="target-setup-body">
            <ui:VisualElement class="target-setup-wizard">
                <ui:VisualElement class="target-setup-nav-row">
                    <ui:Button name="PrevStepButton" tooltip="Previous step" class="switcher-carousel-arrow switcher-carousel-arrow--left target-setup-nav-arrow target-setup-nav-arrow--prev">
                        <ui:VisualElement class="switcher-carousel-arrow__icon switcher-carousel-arrow__icon--left" />
                    </ui:Button>

                    <ui:VisualElement class="target-setup-step-slot">
                        <ui:VisualElement name="StepTrackablePanel" class="target-setup-step-card">
                            <ui:Label text="Image Target" class="target-setup-step-title" />
                            <ui:Label text="Choose the image Vuforia will track in the real world." class="target-setup-step-subtitle" />


                            <ui:Button name="TargetImagePreviewButton" tooltip="Choose trackable image" class="target-setup-image-picker target-setup-image-picker--empty">
                                <ui:VisualElement name="TargetImagePreviewMedia" class="target-setup-image-picker__media" />
                                <ui:VisualElement class="target-setup-image-picker__overlay target-setup-image-picker__overlay--upload">
                                    <ui:VisualElement class="target-setup-image-picker__icon target-setup-image-picker__icon--plus" />
                                    <ui:Label text="Upload image" class="target-setup-image-picker__overlay-label" />
                                </ui:VisualElement>
                                <ui:VisualElement class="target-setup-image-picker__overlay target-setup-image-picker__overlay--change">
                                    <ui:VisualElement class="target-setup-image-picker__icon target-setup-image-picker__icon--cycle" />
                                    <ui:Label text="Change image" class="target-setup-image-picker__overlay-label" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:DropdownField name="TargetPostureDropdown" label="Placement" class="target-setup-field target-setup-field--compact" />
                            <ui:Label text="Where authored content sits relative to the image." class="target-setup-hint target-setup-hint--tight" />
                            <ui:TextField name="PhysicalWidthInput" label="Physical width (m)" value="0.2" class="target-setup-field target-setup-field--compact" />
                        </ui:VisualElement>

                        <ui:VisualElement name="StepNamesPanel" class="target-setup-step-card target-setup-step-card--hidden">
                            <ui:Label text="Workspace &amp; target" class="target-setup-step-title" />
                            <ui:Label text="Name your workspace, then register the target with Vuforia." class="target-setup-step-subtitle" />

                            <ui:TextField name="WorkspaceNameInput" label="Workspace name" class="target-setup-field" />
                            <ui:TextField name="TargetNameInput" label="Target name" class="target-setup-field" />

                            <ui:Label name="StepSummaryLabel" text="" class="target-setup-summary" />

                            <ui:Button name="AdvancedToggleButton" text="Advanced" class="target-setup-advanced-toggle" />
                            <ui:VisualElement name="AdvancedSection" class="target-setup-advanced">
                                <ui:TextField name="TargetIdInput" label="Target ID" class="target-setup-field" />
                                <ui:Label text="Auto-generated from target name if left empty." class="target-setup-hint target-setup-hint--tight" />
                                <ui:Toggle name="UseCustomDisplayLabelToggle" label="Use a different display label" class="target-setup-toggle" />
                                <ui:TextField name="DisplayLabelInput" label="Display label" class="target-setup-field target-setup-field--conditional" />
                                <ui:TextField name="VuforiaTargetNameInput" label="Vuforia target name" class="target-setup-field" />
                                <ui:Label text="Optional override. Usually matches Target ID." class="target-setup-hint target-setup-hint--tight" />
                            </ui:VisualElement>

                            <ui:Button name="SubmitTargetButton" text="Create target &amp; continue" class="btn btn-primary target-setup-submit-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button name="NextStepButton" tooltip="Next step" class="switcher-carousel-arrow switcher-carousel-arrow--right target-setup-nav-arrow target-setup-nav-arrow--next">
                        <ui:VisualElement class="switcher-carousel-arrow__icon switcher-carousel-arrow__icon--right" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="target-setup-step-dots">
                    <ui:VisualElement name="StepDot0" class="target-setup-step-dot target-setup-step-dot--active" />
                    <ui:VisualElement name="StepDot1" class="target-setup-step-dot" />
                </ui:VisualElement>

                <ui:VisualElement name="StatusBanner" class="target-setup-status target-setup-status--idle">
                    <ui:Label name="StatusLabel" text="Click the image area to upload, then use the arrow to continue." class="target-setup-status__text" />
                </ui:VisualElement>

                <ui:Button name="VirtualKeyboardToggleButton" text="Show Keyboard" class="target-setup-keyboard-toggle" />
                <ui:VisualElement name="VirtualKeyboardPanel" class="target-setup-keyboard target-setup-keyboard--hidden">
                    <ui:Label name="VirtualKeyboardTargetLabel" text="Select a field to type." class="target-setup-keyboard__target" />
                    <ui:VisualElement name="VirtualKeyboardKeysContainer" class="target-setup-keyboard__keys" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
